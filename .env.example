# Copy to .env for local development (outside Docker)
# Docker Compose injects these automatically; this file is for dev only.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://dogfood:dogfood@localhost:5432/dogfood"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Fastify backend ──────────────────────────────────────────────────────────
PORT=3001
SESSION_SECRET="dogfood-hackathon-2026-secret"

# ── Seeder ───────────────────────────────────────────────────────────────────
FIXTURES_PATH="../references/fixtures.json"

# ── Next.js frontend ─────────────────────────────────────────────────────────
BACKEND_URL="http://localhost:3001"
NEXT_TELEMETRY_DISABLED=1
