{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "commonjs",
    "lib":             ["ES2022"],
    "outDir":          "./dist",
    "rootDir":         "./",
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration":     true,
    "declarationMap":  true,
    "sourceMap":       true,
    "paths": {
      "@hackathon/contracts": ["./src/contracts/dist"]
    }
  },
  "include": [
    "src/**/*",
    "prisma/seed.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
