{
  "name": "dogfood-backend",
  "version": "1.0.0",
  "description": "DOGFOOD 2026 — Fastify backend (TypeScript)",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@hackathon/contracts": "file:src/contracts",
    "@prisma/client": "^5.14.0",
    "fastify": "^4.27.0",
    "ioredis": "^5.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
